<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    /* Apply the saved (or system) theme before paint to avoid a flash. */
    (function () {
      var theme;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  <meta name="author" content="{{ profile.name }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b0f0e" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="{{ asset_prefix }}src/images/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset_prefix }}src/css/site.css">
</head>
<body class="page--{{ nav_current or 'other' }}">
  <a class="skip-link" href="#main">Skip to content</a>

  {# Floating DNA / RNA / protein motifs are drawn here by site.js #}
  <div class="motifs" data-motifs aria-hidden="true"></div>
  {% if nav_current == 'notes' and note is defined %}<div class="progress" data-progress aria-hidden="true"></div>{% endif %}

  <header class="site-header" data-header>
    <div class="site-header__inner">
      <a class="site-brand" href="{{ asset_prefix }}index.html" aria-label="{{ profile.name }}, home">
        <svg class="site-brand__mark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2c0 5 10 5 10 10S7 17 7 22" />
          <path d="M17 2c0 5-10 5-10 10s10 5 10 10" />
          <path d="M9 5h6M8 8.5h8M8 15.5h8M9 19h6" class="site-brand__rungs" />
        </svg>
        <span>{{ profile.name }}</span>
      </a>
      <nav class="site-nav" aria-label="Primary" data-nav-root>
        <a data-nav="home" href="{{ asset_prefix }}index.html"{% if nav_current == 'home' %} aria-current="page"{% endif %}>Home</a>
        <a data-nav="research" href="{{ asset_prefix }}publications.html"{% if nav_current == 'publications' %} aria-current="page"{% endif %}>Research</a>
        <a data-nav="talks" href="{{ asset_prefix }}talks.html"{% if nav_current == 'talks' %} aria-current="page"{% endif %}>Talks</a>
        <a data-nav="projects" href="{{ asset_prefix }}work.html"{% if nav_current == 'projects' %} aria-current="page"{% endif %}>Projects</a>
        <a data-nav="notes" href="{{ asset_prefix }}blog.html"{% if nav_current == 'notes' %} aria-current="page"{% endif %}>Notes</a>
        <a href="{{ asset_prefix }}{{ home.cv }}" target="_blank" rel="noopener">CV</a>
      </nav>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
    </div>
  </header>

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div>
        <p class="site-footer__name">{{ profile.name }}</p>
        <p class="site-footer__meta">{{ profile.location }}</p>
      </div>
      <nav class="site-footer__links" aria-label="Contact">
        <a href="mailto:{{ profile.email }}">Email</a>
        {% for link in profile.social | default([]) %}
        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
        {% endfor %}
        <a href="{{ asset_prefix }}{{ home.cv }}" target="_blank" rel="noopener">CV</a>
      </nav>
      <p class="site-footer__legal"><span class="mono">5′–</span> © {{ year }} {{ profile.name }} <span class="mono">–3′</span></p>
    </div>
  </footer>
  <script src="{{ asset_prefix }}src/js/site.js" defer></script>
</body>
</html>

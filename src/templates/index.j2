{% extends "base.j2" %}
{% block content %}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    {% if home.eyebrow %}<p class="eyebrow">{{ home.eyebrow }}</p>{% endif %}
    <h1 id="hero-title">{{ home.title }}</h1>
    <p class="hero__summary">{{ home.summary }}</p>

    {% if home.themes %}
    <ul class="hero__themes" aria-label="Research themes">
      {% for theme in home.themes %}<li>{{ theme }}</li>{% endfor %}
    </ul>
    {% endif %}

    {# <div class="hero__actions">
      <a class="button button--primary" href="{{ home.cv }}" target="_blank" rel="noopener">Curriculum vitae <span aria-hidden="true">↗</span></a>
      <a class="button" href="mailto:{{ profile.email }}">Get in touch</a>
    </div> #}

    <figure class="codons" aria-label="The name {{ profile.name.split()[0] }} written as an mRNA sequence and its protein translation">
      <div class="codons__strand">
        <span class="codons__end">5′</span>
        {% for c in codons %}
        <span class="codon{% if c.kind %} codon--{{ c.kind }}{% endif %}" style="--i: {{ loop.index0 }}">
          <span class="codon__nt">{% for nt in c.codon %}<b class="nt nt--{{ nt }}">{{ nt }}</b>{% endfor %}</span>
          <span class="codon__aa">{{ c.aa }}</span>
        </span>
        {% endfor %}
        <span class="codons__end">3′</span>
      </div>
     
    </figure>
  </div>

  <div class="hero__art" aria-hidden="true">
    <canvas class="helix" data-helix></canvas>
  </div>
</section>

<article class="markdown-content home-content">
  {{ home.body_html }}
</article>

{% set heading_tag = 'h3' %}

{% if publications %}
<section class="featured-section" id="research" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title">Recent publications</h2>
    <a class="text-link" href="publications.html">All research <span aria-hidden="true">→</span></a>
  </div>
  <div class="entry-list">
    {% for item in publications[:3] %}{% include "record_card.j2" %}{% endfor %}
  </div>
</section>
{% endif %}

{% if talks %}
<section class="featured-section" id="talks" aria-labelledby="talks-title">
  <div class="section-heading">
    <h2 id="talks-title">Recent talks</h2>
    <a class="text-link" href="talks.html">All talks <span aria-hidden="true">→</span></a>
  </div>
  <div class="entry-list">
    {% for item in talks[:2] %}{% include "record_card.j2" %}{% endfor %}
  </div>
</section>
{% endif %}

{% if notes %}
<section class="featured-section" id="notes" aria-labelledby="notes-title">
  <div class="section-heading">
    <h2 id="notes-title">Notes</h2>
    <a class="text-link" href="blog.html">All notes <span aria-hidden="true">→</span></a>
  </div>
  <div class="entry-list">
    {% for item in notes[:3] %}{% include "record_card.j2" %}{% endfor %}
  </div>
</section>
{% endif %}

{# <section class="cv-section" id="cv" aria-labelledby="cv-title">
  <div class="cv-card reveal">
    <div>
      <p class="eyebrow">Curriculum vitae</p>
      <h2 id="cv-title"></h2>
    </div>
    <div class="cv-card__actions">
      <a class="button button--primary" href="{{ home.cv }}" target="_blank" rel="noopener">View CV <span aria-hidden="true">↗</span></a>
      <a class="button" href="{{ home.cv }}" download>Download</a>
    </div>
  </div>
</section> #}
{% endblock %}
